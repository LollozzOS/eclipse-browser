{
  "manifest_version": 3,
  "name": "Eclipse Scudo",
  "key": "",
  "description": "Blocca pubblicità e traccianti, anche su YouTube e Twitch. Di LollozzOS.",
  "version": "1.1.0",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sfondo.js"
  },
  "action": {
    "default_title": "Eclipse Scudo",
    "default_popup": "finestra.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pubblicita",
        "enabled": true,
        "path": "regole/pubblicita.json"
      },
      {
        "id": "traccianti",
        "enabled": true,
        "path": "regole/traccianti.json"
      },
      {
        "id": "eccezioni",
        "enabled": true,
        "path": "regole/eccezioni.json"
      },
      {
        "id": "cookie",
        "enabled": true,
        "path": "regole/cookie.json"
      }
    ]
  }
}