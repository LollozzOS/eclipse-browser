{
  "distribution": {
    "import_bookmarks": true,
    "import_history": true,
    "import_home_page": false,
    "import_search_engine": false,
    "do_not_create_any_shortcuts": true,
    "do_not_launch_chrome": true,
    "do_not_register_for_update_launch": true,
    "make_chrome_default_for_user": false
  },
  "browser": {
    "check_default_browser": false,
    "enable_spellchecking": false,
    "theme": {
      "color_scheme2": 2
    }
  },
  "background_mode": {
    "enabled": false
  },
  "net": {
    "network_prediction_options": 2
  },
  "profile": {
    "default_content_setting_values": {
      "notifications": 2
    }
  },
  "webrtc": {
    "ip_handling_policy": "disable_non_proxied_udp"
  },
  "media_router": {
    "enable_media_router": false
  },
  "autofill": {
    "credit_card_enabled": false
  },
  "bookmark_bar": {
    "show_on_all_tabs": true
  },
  "search_provider_overrides": [
    {
      "id": 1,
      "name": "Google",
      "keyword": "google.com",
      "favicon_url": "https://www.google.com/favicon.ico",
      "encoding": "UTF-8",
      "search_url": "https://www.google.com/search?q={searchTerms}&ie={inputEncoding}",
      "suggest_url": "https://www.google.com/complete/search?client=chrome&q={searchTerms}"
    },
    {
      "id": 109,
      "name": "Brave",
      "keyword": "search.brave.com",
      "favicon_url": "https://cdn.search.brave.com/serp/favicon.ico",
      "encoding": "UTF-8",
      "search_url": "https://search.brave.com/search?q={searchTerms}",
      "suggest_url": "https://search.brave.com/api/suggest?q={searchTerms}"
    }
  ],
  "search_provider_overrides_version": 1000
}
